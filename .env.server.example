# External data services for deploy/compose.external-data.yml.
# Copy to .env.server at the repository root; real values must never be committed.
# This is independent of .env, which keeps the existing local startup unchanged.
# Use endpoints reachable FROM the application container, not localhost by habit.
# DATABASE_URL shape: postgresql+asyncpg://USER:URL_ENCODED_PASSWORD@HOST:PORT/DB
# REDIS_URL shape: redis://:URL_ENCODED_PASSWORD@HOST:PORT/DB (rediss:// for TLS)
# For Docker Desktop host-side tunnels, the host is typically host.docker.internal.
# Confirm tunnel binding/reachability in task 13B; do not expose data ports publicly.
DATABASE_URL=
REDIS_URL=
# Unique per environment, 1-64 ASCII letters/digits/underscores/hyphens.
# Required for the external stack; logical isolation, not a Redis ACL boundary.
COMICFLOW_REDIS_NAMESPACE=
S3_ENDPOINT=
# Public S3 endpoint must support signed requests for the same bucket and objects.
# A random frontend URL without a working S3 proxy is NOT sufficient.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EXPORT_DOWNLOAD_SECRET=

# If the database already contains encrypted model configs, supply its ORIGINAL
# effective Fernet key here. A new project volume cannot decrypt the local key's data.
# For a genuinely empty database, a key can be created in the new shared volume.
MODEL_CONFIG_ENCRYPTION_KEY=
EXTERNAL_API_PORT=18002

# No automatic provider enablement; saved model registry bindings can override these.
# Connectivity validation must not invoke generation or consume an existing queue.
PROVIDER_MODE=mock
IMAGE_PROVIDER_MODE=disabled
USE_MINIMAX_H3=false
COMICFLOW_COMPOSITION_PROVIDER=ffmpeg
# Production sits behind the ShiploadAI gateway; only X-Control-User-Id is trusted.
# Never set this to 1 on the shared server.
COMICFLOW_DEV_TRUST_X_USER_ID=0
