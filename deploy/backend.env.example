# Copy the completed contents into the BACKEND repo's Drone secret: backend_env.
# This template is for the bundled server stack (compose.backend.yml).
# External existing data services use .env.server.example + compose.external-data.yml;
# backend.sh still deploys the bundled stack and does not select the external file.
# Use a random hexadecimal POSTGRES_PASSWORD (no URL reserved characters).
POSTGRES_PASSWORD=
MINIO_ROOT_USER=comicflow
MINIO_ROOT_PASSWORD=
EXPORT_DOWNLOAD_SECRET=
# Optional Fernet key. If empty/omitted, API and Worker share an auto-created key
# in the persistent model-config volume. Back up that volume with the database.
# MODEL_CONFIG_ENCRYPTION_KEY=
# REQUIRED: reachable by browsers AND model providers, e.g. https://drama.example.com
# For initial HTTP testing: http://YOUR_SERVER_IP:18080 (no trailing path).
S3_PUBLIC_ENDPOINT=

# Start explicitly in mock mode; deployment never tests a paid model.
PROVIDER_MODE=mock
PROVIDER_EVALUATION_GATE=
TEXT_PROVIDER_PROVIDER=bailian
TEXT_PROVIDER_MODEL=qwen-plus
TEXT_PROVIDER_TIMEOUT_MS=120000
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
IMAGE_PROVIDER_MODE=disabled
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_PROVIDER_MODEL=wanx2.1-t2i-plus
IMAGE_PROVIDER_SIZE=720*1280
IMAGE_PROVIDER_TIMEOUT_MS=180000
IMAGE_PROVIDER_PROTOCOL=auto
COMICFLOW_COMPOSITION_PROVIDER=ffmpeg
USE_MINIMAX_H3=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://cp.compshare.cn
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
MINIMAX_PROMPT_MODE=context-ir
MINIMAX_SUBMIT_PATH=/minimax/v2/video_generation
MINIMAX_QUERY_PATH=/minimax/v2/query/video_generation/{task_id}
MINIMAX_TIMEOUT_SECONDS=600
