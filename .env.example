PORT=3000
# Host-native local configuration. Docker's bundled local stack uses service names.
# For external/server data services use .env.server.example and the standalone
# deploy/compose.external-data.yml; do not replace this file to switch running services.
COMICFLOW_RUNTIME=postgresql
DATABASE_URL=postgres://comicflow:comicflow_dev_only@127.0.0.1:15432/comicflow
REDIS_URL=redis://127.0.0.1:16379
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=comicflow
S3_ACCESS_KEY_ID=comicflow
S3_SECRET_ACCESS_KEY=comicflow_dev_only
PROVIDER_MODE=mock
# Real provider evaluation is opt-in. Keep mock until task 09 passes the model gates.
PROVIDER_EVALUATION_GATE=
TEXT_PROVIDER_MODEL=qwen-plus
IMAGE_PROVIDER_MODEL=wanx2.1-t2i-plus
VIDEO_PROVIDER_MODEL=
TTS_PROVIDER_MODEL=
LIPSYNC_PROVIDER_MODEL=musetalk
MODERATION_PROVIDER_MODEL=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
# Set TEXT_PROVIDER_PROVIDER=doubao to use Volcengine Ark for text and H3 Prompt writing.
TEXT_PROVIDER_PROVIDER=bailian
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DEV_USER_ID=local-creator
# Local development only: honour the legacy X-User-Id header when no gateway is
# present. Leave unset/0 in production so only X-Control-User-Id is trusted.
COMICFLOW_DEV_TRUST_X_USER_ID=1
FFMPEG_PATH=ffmpeg
EXPORT_OUTPUT_DIR=var/exports
EXPORT_DOWNLOAD_SECRET=replace-with-a-long-random-secret

# Model catalog secrets: generated on first save if no explicit Fernet key is supplied.
# Keep this file/volume with database backups; never commit the actual key.
MODEL_CONFIG_KEY_FILE=var/config/model-config.key
# MODEL_CONFIG_ENCRYPTION_KEY=

# Independent character/scene reference image API. Saving console config never generates.
IMAGE_PROVIDER_MODE=disabled
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_PROVIDER_SIZE=720*1280
IMAGE_PROVIDER_TIMEOUT_MS=180000
# auto, wan-v2, or wan26-image; model aliases can select a protocol explicitly.
IMAGE_PROVIDER_PROTOCOL=auto
# Optional paths relative to IMAGE_PROVIDER_BASE_URL. Empty uses protocol defaults.
IMAGE_PROVIDER_SUBMIT_PATH=
IMAGE_PROVIDER_QUERY_PATH=
# H3 requires a real text provider to execute the bundled prompt-writing Skill per video.
USE_MINIMAX_H3=false
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://cp.compshare.cn
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_RESOLUTION=768P
# local-skill: local English Skill; context-ir: Chinese input + platform optimization
MINIMAX_PROMPT_MODE=local-skill
MINIMAX_SUBMIT_PATH=/minimax/v2/video_generation
MINIMAX_QUERY_PATH=/minimax/v2/query/video_generation/{task_id}
MINIMAX_TIMEOUT_SECONDS=600
